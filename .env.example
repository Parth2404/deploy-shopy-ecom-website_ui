# Public site origin (used for metadata/OG tags)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Shopify admin OAuth install link for this app (contains the app's client_id)
NEXT_PUBLIC_SHOPIFY_INSTALL_URL=https://admin.shopify.com/?no_redirect=true&redirect=/oauth/redirect_from_developer_dashboard?client_id%3Dyour-client-id

# Base URL of the shopify-ecom_api backend — contact form posts to `${API_URL}/contact`
API_URL=http://localhost:8000
